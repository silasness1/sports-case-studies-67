predict_match_outcome <- function(lambda_A, lambda_B,
                                  draw_threshold = 1/3,
                                  max_goals = 10) {
  
  goals <- 0:max_goals
  
  prob_A <- dpois(goals, lambda_A)
  prob_B <- dpois(goals, lambda_B)
  
  score_matrix <- outer(prob_A, prob_B)
  
  p_win <- sum(score_matrix[row(score_matrix) > col(score_matrix)])
  p_draw <- sum(score_matrix[row(score_matrix) == col(score_matrix)])
  p_loss <- sum(score_matrix[row(score_matrix) < col(score_matrix)])
  
  probabilities <- c(
    Loss = p_loss,
    Draw = p_draw,
    Win = p_win
  )
  
  # First choose between Loss and Win
  predicted <- ifelse(p_loss > p_win, "Loss", "Win")
  
  # Override if draw probability exceeds threshold
  if (p_draw >= draw_threshold) {
    predicted <- "Draw"
  }
  
  list(
    probabilities = probabilities,
    predicted = predicted
  )
}
