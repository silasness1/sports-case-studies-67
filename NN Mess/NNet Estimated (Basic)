fit_goal_nn <- function(train, test,
                        size = 3,
                        decay = 0.1,
                        skip = FALSE,
                        maxit = 1000,
                        seed = 123) {
  
  formula_x <- ~
    GroupStage +
    GDP + MarketValue + FifaRank +
    UefaPoints + CLPlayers +
    GDP_opp + MarketValue_opp + FifaRank_opp +
    UefaPoints_opp + CLPlayers_opp - 1
  
  x_train <- model.matrix(formula_x, data = train)
  x_test  <- model.matrix(formula_x, data = test)
  
  # Make sure test has exactly the training columns
  missing_cols <- setdiff(colnames(x_train), colnames(x_test))
  
  if (length(missing_cols) > 0) {
    extra <- matrix(
      0,
      nrow = nrow(x_test),
      ncol = length(missing_cols),
      dimnames = list(NULL, missing_cols)
    )
    x_test <- cbind(x_test, extra)
  }
  
  x_test <- x_test[, colnames(x_train), drop = FALSE]
  
  # Scale using training data only
  x_center <- colMeans(x_train)
  x_scale <- apply(x_train, 2, sd)
  x_scale[!is.finite(x_scale) | x_scale == 0] <- 1
  
  x_train <- scale(x_train, center = x_center, scale = x_scale)
  x_test  <- scale(x_test, center = x_center, scale = x_scale)
  
  # Transform the response
  y_train <- log1p(train$Goals)
  
  set.seed(seed)
  
  model <- nnet(
    x = x_train,
    y = y_train,
    size = size,
    linout = TRUE,
    skip = skip,
    decay = decay,
    maxit = maxit,
    rang = 0.1,
    MaxNWts = 10000,
    trace = FALSE
  )
  
  # Predictions on transformed scale
  predicted_log <- as.numeric(predict(model, x_test))
  
  # Approximate retransformation correction
  train_fitted <- as.numeric(predict(model, x_train))
  residuals <- y_train - train_fitted
  smearing <- mean(exp(residuals))
  
  # Convert predictions back to goals
  predicted_goals <- pmax(
    0,
    exp(predicted_log) * smearing - 1
  )
  
  list(
    model = model,
    predicted_goals = predicted_goals
  )
}

predict_match_outcome <- function(lambda_A, lambda_B,
                                  draw_threshold = 1/3,
                                  max_goals = 10) {
  
  goals <- 0:max_goals
  
  prob_A <- dpois(goals, lambda_A)
  prob_B <- dpois(goals, lambda_B)
  
  score_matrix <- outer(prob_A, prob_B)
  
  # Normalise probabilities after truncation
  score_matrix <- score_matrix / sum(score_matrix)
  
  p_win <- sum(score_matrix[row(score_matrix) > col(score_matrix)])
  p_draw <- sum(score_matrix[row(score_matrix) == col(score_matrix)])
  p_loss <- sum(score_matrix[row(score_matrix) < col(score_matrix)])
  
  probabilities <- c(
    Loss = p_loss,
    Draw = p_draw,
    Win = p_win
  )
  
  predicted <- if (p_loss > p_win) "Loss" else "Win"
  
  if (p_draw >= draw_threshold) {
    predicted <- "Draw"
  }
  
  list(
    probabilities = probabilities,
    predicted = predicted
  )
}
