tune_goal_nn <- function(train_data, grid) {
  
  inner_years <- sort(unique(train_data$Year))
  
  tuning_results <- vector("list", nrow(grid))
  
  for (g in seq_len(nrow(grid))) {
    
    size_value <- grid$size[g]
    decay_value <- grid$decay[g]
    skip_value <- grid$skip[g]
    
    fold_rmse <- numeric(length(inner_years))
    fold_mae <- numeric(length(inner_years))
    
    for (j in seq_along(inner_years)) {
      
      validation_year <- inner_years[j]
      
      inner_train <- train_data %>%
        filter(Year != validation_year)
      
      inner_valid <- train_data %>%
        filter(Year == validation_year)
      
      fitted <- fit_goal_nn(
        train = inner_train,
        test = inner_valid,
        size = size_value,
        decay = decay_value,
        skip = skip_value,
        seed = 1000 + j
      )
      
      errors <- inner_valid$Goals - fitted$predicted_goals
      
      fold_rmse[j] <- sqrt(mean(errors^2))
      fold_mae[j] <- mean(abs(errors))
    }
    
    tuning_results[[g]] <- data.frame(
      size = size_value,
      decay = decay_value,
      skip = skip_value,
      mean_RMSE = mean(fold_rmse),
      mean_MAE = mean(fold_mae)
    )
  }
  
  tuning_results <- bind_rows(tuning_results) %>%
    arrange(mean_RMSE)
  
  list(
    best = tuning_results %>% slice(1),
    results = tuning_results
  )
}
