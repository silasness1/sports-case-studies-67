tune_nn <- function(outer_train) {
  
  inner_years <- sort(unique(outer_train$Year))
  
  if (length(inner_years) < 2) {
    stop("Not enough tournament years for inner cross-validation.")
  }
  
  grid <- expand.grid(
    size = c(1, 2,3,4),
    decay = c(0.5, 0.8 , 0.3),
    skip = c(FALSE),
    draw_weight = c(0.5,1, 1.5)
  )
  
  thresholds <- c(0.5, 0.40, 0.45)
  
  tuning_results <- data.frame()
  
  for (g in seq_len(nrow(grid))) {
    
    size_value <- grid$size[g]
    decay_value <- grid$decay[g]
    skip_value <- grid$skip[g]
    draw_weight_value <- grid$draw_weight[g]
    
    # Store metrics separately for each threshold
    threshold_metrics <- vector("list", length(thresholds))
    
    names(threshold_metrics) <- as.character(thresholds)
    
    for (validation_year in inner_years) {
      
      inner_train <- outer_train %>%
        filter(Year != validation_year)
      
      inner_valid <- outer_train %>%
        filter(Year == validation_year)
      
      for (seed in 1:3) {
        
        probabilities <- fit_nn(
          train = inner_train,
          test = inner_valid,
          size = size_value,
          decay = decay_value,
          skip = skip_value,
          draw_weight = draw_weight_value,
          seed = seed
        )
        
        for (threshold in thresholds) {
          
          metrics <- calculate_metrics(
            actual = inner_valid$Result,
            probabilities = probabilities,
            draw_threshold = threshold
          )
          
          threshold_metrics[[as.character(threshold)]] <-
            append(
              threshold_metrics[[as.character(threshold)]],
              list(metrics)
            )
        }
      }
    }
    
    # Summarise performance for each threshold
    for (threshold in thresholds) {
      
      metric_list <- threshold_metrics[[as.character(threshold)]]
      
      metric_matrix <- do.call(rbind, metric_list)
      
      tuning_results <- rbind(
        tuning_results,
        data.frame(
          size = size_value,
          decay = decay_value,
          skip = skip_value,
          draw_weight = draw_weight_value,
          draw_threshold = threshold,
          
          mean_accuracy = mean(metric_matrix[, "Accuracy"]),
          mean_macro_f1 = mean(metric_matrix[, "Macro_F1"]),
          mean_draw_recall = mean(metric_matrix[, "Draw_Recall"], na.rm = TRUE),
          mean_draw_precision = mean(metric_matrix[, "Draw_Precision"], na.rm = TRUE),
          mean_logloss = mean(metric_matrix[, "Log_Loss"])
        )
      )
    }
  }
  
  # Select best configuration
  best <- tuning_results %>%
    arrange(
      desc(mean_macro_f1),
      desc(mean_draw_recall),
      mean_logloss
    ) %>%
    slice(1)
  
  list(
    best = best,
    results = tuning_results
  )
}#
