# Create one-hot encoded outcome matrix
make_y <- function(y, classes) {
  
  y_matrix <- matrix(
    0,
    nrow = length(y),
    ncol = length(classes),
    dimnames = list(NULL, classes)
  )
  
  y_matrix[cbind(
    seq_along(y),
    match(as.character(y), classes)
  )] <- 1
  
  y_matrix
}


# Prepare predictors using training data only
prepare_x <- function(train, test) {
  
  formula_x <- as.formula(
    paste("~", paste(predictors, collapse = " + "))
  )
  
  X_train <- model.matrix(formula_x, data = train)
  X_test  <- model.matrix(formula_x, data = test)
  
  # Make sure both matrices have the same columns
  missing_cols <- setdiff(colnames(X_train), colnames(X_test))
  
  if (length(missing_cols) > 0) {
    for (col in missing_cols) {
      X_test <- cbind(X_test, 0)
      colnames(X_test)[ncol(X_test)] <- col
    }
  }
  
  X_test <- X_test[, colnames(X_train), drop = FALSE]
  
  # Calculate scaling parameters using training data only
  x_mean <- colMeans(X_train)
  x_sd <- apply(X_train, 2, sd)
  
  x_sd[is.na(x_sd) | x_sd == 0] <- 1
  
  X_train <- scale(
    X_train,
    center = x_mean,
    scale = x_sd
  )
  
  X_test <- scale(
    X_test,
    center = x_mean,
    scale = x_sd
  )
  
  list(
    train = as.matrix(X_train),
    test = as.matrix(X_test)
  )
}

fit_nn <- function(train, test,
                   size,
                   decay,
                   skip,
                   draw_weight = 1,
                   seed = 123) {
  
  set.seed(seed)
  
  x <- prepare_x(train, test)
  
  y_train <- make_y(train$Result, classes)
  
  # Give draw observations additional weight during training
  case_weights <- ifelse(
    train$Result == "Draw",
    draw_weight,
    1
  )
  
  model <- nnet(
    x = x$train,
    y = y_train,
    size = size,
    softmax = TRUE,
    decay = decay,
    skip = skip,
    weights = case_weights,
    rang = 0.1,
    maxit = 1000,
    MaxNWts = 10000,
    trace = FALSE
  )
  
  probabilities <- predict(
    model,
    newdata = x$test,
    type = "raw"
  )
  
  probabilities <- as.matrix(probabilities)
  colnames(probabilities) <- classes
  
  # Avoid numerical problems in log loss
  probabilities <- pmax(probabilities, 1e-15)
  probabilities <- probabilities / rowSums(probabilities)
  
  probabilities
}

# Multiclass log loss
calculate_logloss <- function(actual, probabilities) {
  
  actual_index <- match(as.character(actual), classes)
  
  -mean(log(
    probabilities[cbind(seq_along(actual_index), actual_index)]
  ))
}

predict_with_draw_threshold <- function(probabilities, draw_threshold) {
  
  # First choose between Loss and Win
  non_draw_probabilities <- probabilities[, c("Loss", "Win"), drop = FALSE]
  
  predicted <- colnames(non_draw_probabilities)[
    max.col(non_draw_probabilities)
  ]
  
  # Override the prediction when Draw probability exceeds the threshold
  predicted[probabilities[, "Draw"] >= draw_threshold] <- "Draw"
  
  factor(predicted, levels = classes)
}

# Classification metrics
calculate_metrics <- function(actual, probabilities,
                              draw_threshold = 1/3) {
  
  predicted <- predict_with_draw_threshold(
    probabilities,
    draw_threshold
  )
  
  confusion <- table(
    factor(actual, levels = classes),
    factor(predicted, levels = classes)
  )
  
  accuracy <- mean(predicted == actual)
  
  recall <- diag(confusion) / rowSums(confusion)
  precision <- diag(confusion) / colSums(confusion)
  
  names(recall) <- classes
  names(precision) <- classes
  
  # F1 is zero when a class has no predicted observations
  f1 <- 2 * precision * recall / (precision + recall)
  f1[!is.finite(f1)] <- 0
  
  c(
    Accuracy = accuracy,
    Balanced_Accuracy = mean(recall, na.rm = TRUE),
    Macro_F1 = mean(f1),
    Draw_Recall = unname(recall["Draw"]),
    Draw_Precision = unname(precision["Draw"]),
    Log_Loss = calculate_logloss(actual, probabilities)
  )
}#

calculate_metrics_from_predictions <- function(actual, predicted,
                                               probabilities = NULL) {
  
  confusion <- table(
    Actual = factor(actual, levels = classes),
    Predicted = factor(predicted, levels = classes)
  )
  
  recall <- diag(confusion) / rowSums(confusion)
  precision <- diag(confusion) / colSums(confusion)
  
  f1 <- 2 * precision * recall / (precision + recall)
  f1[!is.finite(f1)] <- 0
  
  result <- c(
    Accuracy = sum(diag(confusion)) / sum(confusion),
    Balanced_Accuracy = mean(recall),
    Macro_F1 = mean(f1),
    Draw_Recall = recall["Draw"],
    Draw_Precision = precision["Draw"]
  )
  
  if (!is.null(probabilities)) {
    result <- c(
      result,
      Log_Loss = calculate_logloss(actual, probabilities)
    )
  }
  
  result
}
