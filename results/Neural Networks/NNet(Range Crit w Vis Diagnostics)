    inner_years = inner_years,
    threshold_grid = threshold_grid
  )
  
  best_threshold <- threshold_tuning$best_threshold
  
  cat("\nBest draw probability threshold:\n")
  print(best_threshold)
  
  
  # --------------------------------
  # 3. Fit final goal NN
  # --------------------------------
  
  final_goal_predictions <- fit_goal_nn(
    train = outer_train,
    test = outer_test,
    size = best_params$size,
    decay = best_params$decay,
    skip = best_params$skip
  )
  
  
  # --------------------------------
  # 4. Pair team predictions
  # --------------------------------
  
  match_predictions <- pair_team_predictions(
    final_goal_predictions
  )
  
  
  # --------------------------------
  # 5. Calculate Poisson probabilities
  # --------------------------------
  
  probabilities <- t(
    vapply(
      seq_len(nrow(match_predictions)),
      function(i) {
        
        predict_match_probabilities(
          match_predictions$lambda_A[i],
          match_predictions$lambda_B[i]
        )
        
      },
      FUN.VALUE = c(
        Loss = 0,
        Draw = 0,
        Win = 0
      )
    )
  )
  
  match_predictions <- bind_cols(
    match_predictions,
    as.data.frame(probabilities)
  )
  
  
  # --------------------------------
  # 6. Actual outcomes
  # --------------------------------
  
  match_predictions <- match_predictions %>%
    mutate(
      Actual = case_when(
        Goals_A > Goals_B ~ "Win",
        Goals_A == Goals_B ~ "Draw",
        TRUE ~ "Loss"
      )
    )
  
  
  # --------------------------------
  # 7. Apply selected threshold
  # --------------------------------
  
  predicted <- vapply(
    seq_len(nrow(match_predictions)),
    function(i) {
      
      classify_match(
        p_loss = match_predictions$Loss[i],
        p_draw = match_predictions$Draw[i],
        p_win = match_predictions$Win[i],
        delta = best_threshold
      )
      
    },
    character(1)
  )
  
  match_predictions$Predicted <- predicted
  
  
  # --------------------------------
  # 8. Store outer predictions
  # --------------------------------
  
  outer_predictions[[as.character(test_year)]] <-
    match_predictions %>%
    mutate(
      Best_Threshold = best_threshold,
      Best_Size = best_params$size,
      Best_Decay = best_params$decay,
      Best_Skip = best_params$skip
    )
  
  
  # --------------------------------
  # 9. Store tuning results
  # --------------------------------
  
  outer_tuning_results[[as.character(test_year)]] <-
    goal_tuning$all_results %>%
    mutate(
      Outer_Test_Year = test_year
    )
  
  outer_threshold_results[[as.character(test_year)]] <-
    threshold_tuning$all_results %>%
    mutate(
      Outer_Test_Year = test_year
    )
  
  
  cat("\nOuter test matches:",
      nrow(match_predictions), "\n")
  
  cat("Outer test predictions completed.\n")
}


