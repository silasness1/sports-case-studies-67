fit_goal_nn <- function(train, test,
                        size,
                        decay,
                        skip,
                        maxit = 1000) {
  
  # Create predictor matrices
  x_train <- as.matrix(
    train[, predictors]
  )
  
  x_test <- as.matrix(
    test[, predictors]
  )
  
  storage.mode(x_train) <- "double"
  storage.mode(x_test) <- "double"
  
  # Standardise using training data only
  train_means <- colMeans(x_train)
  train_sds <- apply(x_train, 2, sd)
  
  train_sds[
    is.na(train_sds) | train_sds == 0
  ] <- 1
  
  x_train <- scale(
    x_train,
    center = train_means,
    scale = train_sds
  )
  
  x_test <- scale(
    x_test,
    center = train_means,
    scale = train_sds
  )
  
  # Log-transform goals
  y_train <- log1p(train$Goals)
  
  # Fit neural network
  set.seed(123)
  
  model <- nnet(
    x = x_train,
    y = y_train,
    size = size,
    decay = decay,
    skip = skip,
    linout = TRUE,
    maxit = maxit,
    trace = FALSE
  )
  
  # Training predictions for smearing correction
  train_pred <- as.vector(
    predict(model, x_train)
  )
  
  residuals <- y_train - train_pred
  
  smearing <- mean(exp(residuals))
  
  # Test predictions
  test_pred_log <- as.vector(
    predict(model, x_test)
  )
  
  # Back-transform to goals
  test_pred <- exp(test_pred_log) * smearing - 1
  
  # Expected goals cannot be negative
  test_pred <- pmax(test_pred, 0)
  
  # Return predictions
  results <- test %>%
    mutate(
      Predicted_Goals = test_pred,
      Actual_Goals = Goals
    ) %>%
    select(
      Year,
      GroupStage,
      Team,
      Opponent,
      Actual_Goals,
      Predicted_Goals
    )
  
  return(results)
}


pair_team_predictions <- function(predictions) {
  
  matches <- predictions %>%
    mutate(
      Team = as.character(Team),
      Opponent = as.character(Opponent),
      
      Team_A = pmin(Team, Opponent),
      Team_B = pmax(Team, Opponent)
    ) %>%
    
    group_by(
      Year,
      GroupStage,
      Team_A,
      Team_B
    ) %>%
    
    summarise(
      
      lambda_A =
        Predicted_Goals[Team == first(Team_A)][1],
      
      lambda_B =
        Predicted_Goals[Team == first(Team_B)][1],
      
      Goals_A =
        Actual_Goals[Team == first(Team_A)][1],
      
      Goals_B =
        Actual_Goals[Team == first(Team_B)][1],
      
      .groups = "drop"
    )
  
  return(matches)
}


predict_match_probabilities <- function(
    lambda_A,
    lambda_B,
    max_goals = 20) {
  
  goals <- 0:max_goals
  
  # Individual Poisson probabilities
  prob_A <- dpois(goals, lambda_A)
  prob_B <- dpois(goals, lambda_B)
  
  # Joint scoreline probabilities
  score_matrix <- outer(prob_A, prob_B)
  
  # Normalise truncated probabilities
  score_matrix <- score_matrix / sum(score_matrix)
  
  # Team A wins
  p_win <- sum(
    score_matrix[
      row(score_matrix) > col(score_matrix)
    ]
  )
  
  # Draw
  p_draw <- sum(
    score_matrix[
      row(score_matrix) == col(score_matrix)
    ]
  )
  
  # Team A loses
  p_loss <- sum(
    score_matrix[
      row(score_matrix) < col(score_matrix)
    ]
  )
  
  return(
    c(
      Loss = p_loss,
      Draw = p_draw,
      Win = p_win
    )
  )
}
delta_grid <- seq(0, 0.40, by = 0.025)
override_grid <- seq(0.35, 0.60, by = 0.025)
classify_match <- function(p_loss,p_draw,p_win, delta, override_threshold=0.45) {
  
  difference <- abs(max(p_win,p_loss,p_draw)-min(p_win,p_loss,p_draw))
  max_prob <- pmax(p_loss, p_draw, p_win)
  override <- max_prob >= override_threshold
  #ifelse(p_draw >0.33
  normal_pred=ifelse(
    difference<delta,
    "Draw",
    ifelse(
      p_win < p_loss,
      "Loss",
      "Win"
    )
  )
  override_prediction <- case_when(
    p_loss == max_prob ~ "Loss",
    p_draw == max_prob ~ "Draw",
    p_win == max_prob ~ "Win"
  )
  ifelse(
    override,
    override_prediction,
    normal_pred
  )
}


calculate_macro_f1 <- function(actual, predicted) {
  
  actual <- factor(actual, levels = classes)
  predicted <- factor(predicted, levels = classes)
  
  cm <- table(
    Predicted = predicted,
    Actual = actual
  )
  
  f1_values <- numeric(length(classes))
  
  for (i in seq_along(classes)) {
    
    tp <- cm[i, i]
    
    fp <- sum(cm[i, ]) - tp
    
    fn <- sum(cm[, i]) - tp
    
    precision <- ifelse(
      tp + fp == 0,
      0,
      tp / (tp + fp)
    )
    
    recall <- ifelse(
      tp + fn == 0,
      0,
      tp / (tp + fn)
    )
    
    f1_values[i] <- ifelse(
      precision + recall == 0,
      0,
      2 * precision * recall /
        (precision + recall)
    )
  }
  
  mean(f1_values)
}


tune_goal_nn <- function(
    outer_train,
    tuning_grid,
    inner_years) {
  
  results <- list()
  
  for (i in seq_len(nrow(tuning_grid))) {
    
    size_value <- tuning_grid$size[i]
    decay_value <- tuning_grid$decay[i]
    skip_value <- tuning_grid$skip[i]
    
    fold_rmse <- c()
    fold_mae <- c()
    
    for (valid_year in inner_years) {
      
      inner_train <- outer_train %>%
        filter(Year != valid_year)
      
      inner_valid <- outer_train %>%
        filter(Year == valid_year)
      
      predictions <- fit_goal_nn(
        train = inner_train,
        test = inner_valid,
        size = size_value,
        decay = decay_value,
        skip = skip_value
      )
      
      rmse <- sqrt(
        mean(
          (predictions$Actual_Goals -
             predictions$Predicted_Goals)^2
        )
      )
      
      mae <- mean(
        abs(
          predictions$Actual_Goals -
            predictions$Predicted_Goals
        )
      )
      
      fold_rmse <- c(fold_rmse, rmse)
      fold_mae <- c(fold_mae, mae)
    }
    
    results[[i]] <- data.frame(
      size = size_value,
      decay = decay_value,
      skip = skip_value,
      mean_RMSE = mean(fold_rmse),
      mean_MAE = mean(fold_mae)
    )
  }
  
  results <- bind_rows(results)
  
  best_params <- results %>%
    arrange(mean_RMSE, mean_MAE) %>%
    slice(1)
  
  return(
    list(
      best_params = best_params,
      all_results = results
    )
  )
}


tune_draw_threshold <- function(
    outer_train,
    best_params,
    inner_years,
    threshold_grid) {
  
  inner_predictions <- list()
  
  # Generate inner out-of-fold predictions
  for (valid_year in inner_years) {
    
    inner_train <- outer_train %>%
      filter(Year != valid_year)
    
    inner_valid <- outer_train %>%
      filter(Year == valid_year)
    
    # Fit neural network
    goal_predictions <- fit_goal_nn(
      train = inner_train,
      test = inner_valid,
      size = best_params$size,
      decay = best_params$decay,
      skip = best_params$skip
    )
    
    # Pair team predictions
    matches <- pair_team_predictions(
      goal_predictions
    )
    
    # Actual outcomes
    matches <- matches %>%
      mutate(
        Actual = case_when(
          Goals_A > Goals_B ~ "Win",
          Goals_A == Goals_B ~ "Draw",
          TRUE ~ "Loss"
        )
      )
    
    # Calculate Poisson probabilities
    probabilities <- t(
      vapply(
        seq_len(nrow(matches)),
        function(i) {
          
          predict_match_probabilities(
            matches$lambda_A[i],
            matches$lambda_B[i]
          )
          
        },
        FUN.VALUE = c(
          Loss = 0,
          Draw = 0,
          Win = 0
        )
      )
    )
    
    matches <- bind_cols(
      matches,
      as.data.frame(probabilities)
    )
    
    inner_predictions[[as.character(valid_year)]] <-
      matches
  }
  
  # Combine all inner predictions
  inner_predictions <- bind_rows(
    inner_predictions
  )
  
  # Evaluate candidate thresholds
  threshold_results <- list()
  
  for (threshold in threshold_grid) {
    
    fold_scores <- c()
    
    for (valid_year in inner_years) {
      
      year_data <- inner_predictions %>%
        filter(Year == valid_year)
      
      predicted <- vapply(
        seq_len(nrow(year_data)),
        function(i) {
          
          classify_match(
            p_loss = year_data$Loss[i],
            p_draw = year_data$Draw[i],
            p_win = year_data$Win[i],
            delta = threshold,
          )
          
        },
        character(1)
      )
      
      fold_scores <- c(
        fold_scores,
        calculate_macro_f1(
          actual = year_data$Actual,
          predicted = predicted
        )
      )
    }
    
    threshold_results[[as.character(threshold)]] <-
      data.frame(
        threshold = threshold,
        mean_macro_F1 = mean(fold_scores)
      )
  }
  
  threshold_results <- bind_rows(
    threshold_results
  )
  
  # Select best threshold
  best_threshold <- threshold_results %>%
    arrange(
      desc(mean_macro_F1),
      threshold
    ) %>%
    slice(1)
  
  return(
    list(
      best_threshold = best_threshold$threshold,
      all_results = threshold_results,
      inner_predictions = inner_predictions
    )
  )
}


